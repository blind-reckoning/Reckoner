# macOS
.DS_Store

# Editors
.obsidian/

# KiCad: backups, autosaves, locks, caches and per-user view state
*-backups/
_autosave-*
\#auto_saved_files\#
*.lck
fp-info-cache
*.kicad_prl
*.bak
*-bak
.history/

# Firmware build output
.pio/
build/
.esphome/

# Secrets (Wi-Fi credentials, API keys)
secrets.yaml
.env

# Private working notes (owner's decision): never tracked.
private/

# Markdown stays local, except the root README and the brand book.
*.md
!/README.md
!/brand/**/*.md
